#!/bin/sh
# Refuse une POUSSEE dont un commit de la plage n'est pas conforme.
#
# LE TROU QUE CE HOOK FERME. Le controle d'identite de ce depot couvrait
# `pre-commit` et `pre-merge-commit`, jamais `push` : les neuf poussees de ce
# chantier ont chacune ete protegees par une verification que le pilote ecrivait
# A LA MAIN. Un garde-fou qui repose sur la memoire du suivant n'est pas un
# garde-fou — c'est ecrit dans le Makefile de ce depot, et c'est le motif meme
# de `scripts/installer-les-garde-fous.sh`.
#
# L'ENJEU EST MESURE, PAS SUPPOSE. Sept commits sont partis une fois sous une
# adresse professionnelle : il a fallu reecrire 165 commits, PUIS detruire et
# recreer le depot sur GitHub, la liste des contributeurs une fois constituee ne
# se defaisant pas. Le commit local se defait ; la poussee, non.
#
# ── CE QUI REND `pre-push` DIFFERENT DE `pre-commit`, ET C'EST TOUT LE SUJET ──
#
# `pre-commit` valide LE commit qu'on fabrique. `pre-push` doit valider TOUS les
# commits de la plage qui part, et cette plage lui arrive sur l'ENTREE STANDARD,
# une ligne par ref poussee :
#
#     <ref locale> <sha local> <ref distante> <sha distant>
#
# Un hook qui ne verifierait que `HEAD` laisserait passer neuf commits sur dix,
# et il serait VERT sous toute scene ou le defaut est ailleurs qu'en tete — la
# forme de garde decoratif que ce chantier a trouvee sept fois sur huit
# bloquantes. La plage est donc lue ref par ref, et le commit du MILIEU est
# eprouve explicitement par
# `tests/unit/test_installation_des_garde_fous.py`,
# `TestLaPousseeEstGardeeSurTouteLaPlage`.
#
# ── CE QUI EST VERIFIE, ET SUR QUEL AXE ──
#
#   1. l'ADRESSE d'auteur ET de committer de chaque commit de la plage. **Sur
#      l'adresse, JAMAIS sur le nom** : deux identites portent « Florian
#      Horellou », donc un controle sur le nom ne voit rien. C'est le §2.1 du
#      pilotage, et c'est la faute qui a coute ce depot ;
#   2. l'absence d'ATTRIBUTION a un assistant de generation de code, sur les
#      deux FORMES que produisent reellement ces outils — un trailer
#      `Co-Authored-By:` et une ligne de signature « generated with/by » — plus
#      l'emoji de robot. Le vocabulaire est celui que le registre de ce depot
#      emploie deja pour la meme detection (§4.32) ;
#   3. l'absence de SECRET dans les lignes AJOUTEES de la plage.
#
# ── LES TROIS BORNES, ECRITES PLUTOT QUE TUES ──
#
# - **une MENTION en prose n'est pas refusee.** Ce depot documente sa propre
#   regle sur plusieurs pages, et un message de commit qui la raconte est
#   legitime. Un hook qui refuserait le mot enseignerait le seul geste que ce
#   chantier interdit absolument — `--no-verify` — et un garde qu'on desarme
#   pour travailler ne garde plus rien. Seules les FORMES d'attribution sont
#   refusees ;
# - **le NOM d'auteur n'est filtre que sur deux marqueurs de robot** : un suffixe
#   `[bot]` et l'emoji. Un nom d'assistant pose avec une adresse autorisee
#   passerait donc — c'est assume, parce que la regle d'identite de ce depot
#   refuse explicitement de decider sur le nom, et qu'une liste de noms de
#   produits vieillirait a chaque sortie. L'axe qui mord est l'adresse ;
# - **la detection de secret est un jeu de formes A HAUTE CONFIANCE**, pas un
#   detecteur generique. `detect-secrets` n'est pas arme sur ce depot et
#   `.pre-commit-config.yaml` dit pourquoi ; ce hook n'essaie pas de le
#   remplacer. Il refuse ce qui est indubitable — en-tete de cle privee, jetons
#   a prefixe reconnaissable — et ce qui n'est PAS refuse reste nomme ici. Un
#   `pre-push` qui refuse tout est aussi inutile qu'un `pre-push` qui accepte
#   tout, et le second sens est eprouve : la plage propre de ce depot passe.
#
# Aucune sortie n'est produite quand tout est conforme : un hook bavard au
# succes apprend a ne plus le lire.
set -eu

# Les DEUX seules adresses autorisees. Ce site est le troisieme au runtime
# (`scripts/git-hooks/pre-commit`, sa copie figee par l'installation, et
# celui-ci) : les modifier ensemble est ce que `make install` reinstalle.
ADRESSES_AUTORISEES="florian.horellou@gmail.com florian_horellou@laposte.net"

# Les FORMES d'attribution, et non le vocabulaire en prose. `-i` est applique a
# l'appel. `^[[:space:]]*` : un trailer vit en tete de ligne, un recit ne s'y
# trouve pas par accident.
#
# **LA DEUXIEME ALTERNATIVE N'ETAIT PAS ANCREE, ET C'EST LA CORRECTION DU
# 9 SEPTEMBRE 2026.** Les trois autres portaient leur `^[[:space:]]*` ; la
# ligne de signature, non. Un message de commit qui RACONTE la forme — et ce
# depot documente sa propre regle sur plusieurs pages — etait donc refuse au
# milieu d'une phrase, et les deux seules sorties etaient `--no-verify`, que ce
# chantier interdit absolument, ou le retrait du garde.
#
# `mesure` le 9 septembre 2026, motif d'alors, chaine assemblee par programme :
# les trois phrases « le motif refuse la forme … », « on documente que … » et la
# forme nue etaient TOUTES LES TROIS refusees. Apres ancrage : les deux recits
# passent, la forme nue reste refusee.
#
# **C'EST MOT POUR MOT LE DEFAUT CORRIGE DANS `e42d3e6` POUR LE MOTIF DE
# SECRET**, une ligne plus bas, sur ce meme raisonnement : un garde qui provoque
# la panne qu'il surveille. Le trouver deux fois dans le meme motif dit que la
# propriete « chaque alternative porte sa borne » doit etre gardee, pas relue.
#
# Il etait LATENT — `git log --format='%B' | grep -icE 'generated (with|by) \['`
# rend **0** sur toute l'histoire (`mesure` le meme jour) — et c'est precisement
# ce qui le rendait invisible : le premier rapport qui nomme la forme est le
# premier a ne plus pouvoir etre commite.
#
# La borne de ce choix est ecrite et assumee : une signature INDENTEE reste
# refusee (`[[:space:]]*`), une signature au milieu d'une ligne de prose passe.
# C'est la meme borne que les trois autres alternatives, et celle que ce hook
# s'est deja donnee en tete — seules les FORMES sont refusees, jamais les
# MENTIONS. Garde dans les deux sens par
# `test_un_message_qui_RACONTE_la_signature_n_est_pas_refuse`.
FORMES_D_ATTRIBUTION='^[[:space:]]*co-authored-by:|^[[:space:]]*generated (with|by) \[|^[[:space:]]*(co-)?authored-by:.*\[bot\]|🤖'

# Les formes de secret a haute confiance. Chacune porte un prefixe ou un en-tete
# qui ne se rencontre pas par hasard dans une ligne de prose.
#
# **CE MOTIF COMMENCE PAR UN TIRET, ET C'EST UN PIEGE MESURE.** Passe en
# argument nu — `grep -qE "$FORMES_DE_SECRET"` —, `grep` le lit comme une
# OPTION : il rend `rc=2` sur « unrecognized option », le `if` le lit comme
# faux, et le hook sort en **0 sans avoir rien verifie**. `mesure` le
# 9 septembre 2026 en retournant ce hook contre les 276 commits de ce depot :
# `rc=0`, et la verification n'avait pas tourne une seule fois. Un `rc` juste
# pour la mauvaise raison, exactement la famille de defaut que ce chantier
# traque. Tous les motifs sont donc passes par `-e`, et cette propriete est
# gardee par `test_le_motif_de_secret_est_bien_passe_a_grep_et_non_lu_comme_une_option`.
#
# **ET AUCUNE ALTERNATIVE N'EST ECRITE EN LITTERAL PUR — C'EST LA CORRECTION DU
# 9 SEPTEMBRE 2026, ET ELLE VIENT D'UN VRAI `git push`.** La premiere ecriture
# de ce motif portait une cinquieme alternative, l'en-tete d'un format de cle
# precis, ECRIT EN ENTIER. Cette alternative SE RECONNAISSAIT ELLE-MEME, et elle
# etait de surcroit reconnue par la premiere : la ligne qui pose le motif est
# une ligne AJOUTEE, elle portait donc un « secret », et le hook refusait le
# commit meme qui l'introduit. `mesure` ce jour-la, `git push` reel vers un
# distant jetable : `rc=1` sur le commit du hook, message « une ligne ajoutee
# porte un secret », et aucune ref chez le distant. Un garde qui provoque la
# panne qu'il surveille, dont les deux seules sorties auraient ete
# `--no-verify` — que ce chantier interdit — ou le retrait du garde.
#
# L'alternative etait par ailleurs REDONDANTE : la premiere, generique, la
# couvre entierement. Sa suppression est donc la correction complete, et elle ne
# retire aucune couverture.
#
# **CE QUI PROTEGE LES QUATRE QUI RESTENT N'EST PAS D'ETRE ECRITES EN
# MORCEAUX**, et c'est mesure dans les deux sens : chacune porte, apres son
# prefixe litteral, une CLASSE de caracteres — `[A-Z ]*`, `[0-9A-Z]{16}` — dont
# le texte source (`[`, `{`) n'appartient a aucune des classes attendues. Une
# premiere correction avait assemble le motif de cle en deux variables ; la
# mesure a montre que l'assemblage n'y etait pour rien, et il a ete retire
# plutot que garde sur un motif faux. La propriete est gardee pour les quatre
# par `test_le_hook_ne_reconnait_aucune_de_ses_propres_lignes_comme_un_secret`,
# qui rougit bien sur la remise de l'alternative litterale.
FORMES_DE_SECRET='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|xox[abprs]-[A-Za-z0-9-]{10,}'

refuse() {
    echo "POUSSEE REFUSEE : $1" >&2
    echo "  commit $2" >&2
    echo "" >&2
    echo "La poussee ne se defait pas comme un commit : sur ce depot, sept" >&2
    echo "commits partis sous une mauvaise adresse ont coute la reecriture de" >&2
    echo "165 commits PUIS la destruction et la recreation du depot sur GitHub." >&2
    echo "Corrige l'historique — jamais « git push --no-verify »." >&2
    exit 1
}

# Un sha entierement nul designe une absence : ref creee (cote distant) ou ref
# supprimee (cote local). Le test porte sur la FORME, pour valoir aussi bien
# pour un depot en sha1 (40 zeros) qu'en sha256 (64).
est_nul() {
    case "$1" in
        *[!0]*) return 1 ;;
        "") return 1 ;;
        *) return 0 ;;
    esac
}

# `pre-push` recoit le nom du distant en premier argument, et son URL en second.
distant="${1:-origin}"

# ── LA BORNE D'UNE REF NEUVE, ET C'EST LA CORRECTION DU 9 SEPTEMBRE 2026 ──
#
# **CE QUI ETAIT ECRIT ICI ETAIT AVEUGLE A LA SEQUENCE EXACTE DU SINISTRE DE CE
# DEPOT.** La premiere ecriture bornait la plage d'une ref neuve par
# `git rev-list "$sha_local" --not --remotes="$distant"`. Or `--remotes=<distant>`
# **n'interroge pas le distant** : il lit `refs/remotes/<distant>/*`, un CACHE
# LOCAL. Des que ce cache est perime, tout commit atteignable depuis lui sort de
# la plage ALORS QU'IL N'EST PAS CHEZ LE DISTANT.
#
# `mesure` le 9 septembre 2026, depots jetables, `git push` REEL, hook alors
# INTACT — la scene suffisait, aucune mutation n'etait necessaire :
#
#   10 commits fabriques, dont 7 sous une adresse non autorisee, POUSSES, refs
#   de suivi a jour ; puis le distant est DETRUIT ET RECREE VIDE
#   (`git ls-remote` rend 0 ref, la ref de suivi locale survit).
#
#     ce que le hook verifiait  : 0 commit   (`rev-list HEAD --not --remotes=origin`)
#     ce qui partait            : 10 commits
#     `rc` du `git push`        : 0
#     arrive chez le distant    : 7 commits sous l'adresse non autorisee
#
# **CE N'EST PAS UNE SCENE D'ECOLE.** Ce depot a ete detruit et recree sur
# GitHub — `created_at = 2026-08-28` pour un premier commit du 2026-04-30 — et
# c'est precisement cet incident que ce hook existe pour empecher. Sous cette
# sequence, le garde ne contribuait rien, et il est MUET AU SUCCES par
# conception : rien ne l'aurait dit.
#
# ── LE FAIT EXTERIEUR PLUTOT QUE LE CACHE, ET LES FORMES PESEES ──
#
# La borne est desormais l'ETAT REEL DU DISTANT, demande par `git ls-remote`.
# Trois autres formes ont ete pesees et ecartees :
#
# - *un COMMIT D'EPOQUE en dur* — exclure ce qui est atteignable depuis le
#   commit qui a arme ce garde. Local, deterministe, sans reseau, et il exprime
#   litteralement le compromis defendu. **Mais il ne ferme PAS le sinistre** :
#   les commits fautifs de la scene sont anterieurs a l'epoque, donc exclus, et
#   la poussee repasserait. Une borne qui laisse passer l'incident qu'elle
#   documente n'est pas une borne ;
# - *`refs/remotes/` rafraichi par un `git fetch` prealable* — c'est encore le
#   cache, avec une fenetre de course en plus, et un `fetch` dans un `pre-push`
#   est un effet de bord que personne n'attend d'un hook ;
# - *ne rien exclure du tout* — le plus sur, et son cout a ete MESURE plutot que
#   suppose (voir ci-dessous). Ecarte pour la seule latence : sur une ref neuve
#   dont le distant porte deja `main`, `ls-remote` ramene la plage aux commits
#   propres a la branche, ce que ne rien exclure ne fait pas.
#
# ── ET LA JUSTIFICATION DE LA BORNE, QUI ETAIT FAUSSE, EST CORRIGEE ──
#
# Le commentaire precedent affirmait que sans borne une branche neuve ferait
# verifier « les 184 commits anterieurs a ce garde — UN REFUS CERTAIN sur du
# passe qu'on ne reecrira pas ». **Cette phrase est fausse sur ce depot, et
# c'est mesure.** L'histoire de ce depot a ete REECRITE — 165 commits — donc
# elle est conforme, et `test_la_plage_reelle_de_ce_depot_passe` l'asserte deja.
# Retourner ce hook contre la totalite de l'histoire, plage NON bornee :
#
#     `mesure` le 9 septembre 2026, 282 commits, 84 396 lignes ajoutees
#     traversees, **0 refus**, en **10,1 s**
#     (commande : boucle du corps de ce hook sur `git rev-list HEAD`)
#
# Le cout d'une plage ouverte est donc de la LATENCE, pas un refus. C'est ce qui
# rend le repli sur « tout verifier » tenable, et c'est pourquoi il est choisi
# chaque fois que l'etat du distant n'est pas connaissable.
#
# ── LE REPLI EST FAIL-CLOSED, ET IL EST BAVARD ──
#
# Si `ls-remote` echoue ou expire — hors reseau, identifiants absents, distant
# injoignable — on n'exclut RIEN : la plage s'ouvre sur tout ce qui part, ce qui
# verifie PLUS et jamais moins. Un sha que le distant annonce mais que ce clone
# n'a pas est ecarte de la meme facon, et pour la meme raison : `rev-list`
# sortirait en erreur, et un hook qui cale est un hook qu'on desarme.
#
# Ce repli est le SEUL endroit ou ce hook parle sans refuser, et c'est
# delibere : une borne dont on ne sait plus si elle a servi doit se dire, sinon
# elle redevient la cecite qu'on vient de fermer.
#
# ── UN RISQUE LATENT A NOMMER, PARCE QU'IL EST MUET ──
#
# `pre_commit/commands/hook_impl.py:36` porte `if hook_dir is None:  # git 2.54+
# hooks`, chemin sur lequel la couche `.legacy` — c'est-a-dire CE fichier —
# **n'est jamais executee**. Git est ici en **2.53.0** (`mesure` le 9 septembre
# 2026, `git --version`) et le `hook-tmpl` passe toujours `--hook-dir`, donc le
# montage est sain aujourd'hui. Mais le seul rempart « valable pour toute
# branche » de ce depot depend d'une branche de code que la version SUIVANTE de
# git active, et la panne serait muette : `rc=0`, rien de verifie. A la montee
# de git, remesurer que `pre-push.legacy` est bien atteint.
#
# ── LA BORNE QUI RESTE, ET ELLE EST EPROUVEE DANS LES DEUX SENS ──
#
# Une branche neuve dont l'histoire ancienne est REELLEMENT chez le distant
# continue de passer : `ls-remote` la ramene, elle est exclue, et seuls les
# commits propres a la branche sont verifies. Un garde qui refuserait ce geste
# legitime serait arrache le premier jour. Les deux sens vivent dans
# `TestLaPousseeEstGardeeParUnVraiGitPush`, qui execute `git push` et asserte
# **l'etat du distant** — pas seulement le `rc`.
shas_annonces_par_le_distant() {
    # `ls-remote` et non `--remotes=` : on DEMANDE, on ne relit pas un cache.
    # Le `timeout` est exterieur au processus git : un hook qui pend est un hook
    # qu'on desarme, et l'attente ne doit pas dependre des reglages du transport.
    if command -v timeout >/dev/null 2>&1; then
        timeout 30 git ls-remote "$distant" 2>/dev/null || return 1
    else
        git ls-remote "$distant" 2>/dev/null || return 1
    fi
}

# Les shas que le distant annonce ET que ce clone possede. Ecrit en fonction
# pour que le `for` ne vive pas dans un sous-shell de pipeline, ou l'accumulation
# serait perdue.
exclusions_pour_une_ref_neuve() {
    annonces=$(shas_annonces_par_le_distant) || return 1
    exclusions=""
    for annonce in $(printf '%s\n' "$annonces" | awk '{ print $1 }'); do
        if git rev-parse --quiet --verify "$annonce^{commit}" >/dev/null 2>&1; then
            exclusions="$exclusions $annonce"
        fi
    done
    printf '%s' "$exclusions"
}

# ── LA PANNE TOTALE ET SILENCIEUSE A UN CARACTERE PRES ──
#
# `|| [ -n "..." ]` n'est pas une precaution de style : sans lui, une entree
# standard SANS RETOUR A LA LIGNE FINAL fait rendre non-zero a `read`, la boucle
# ne tourne pas une seule fois, et **ce hook rend `rc=0` sans avoir rien
# verifie**. `read` a pourtant bien affecte les variables : c'est le `rc` seul
# qui mentait.
#
# `mesure` le 9 septembre 2026 :
#
#     printf 'a b c d'   | sh   -c 'n=0; while read -r w x y z; do n=$((n+1)); done; echo $n'  -> 0
#     printf 'a b c d\n' | sh   -c '...'                                                       -> 1
#     printf 'a b c d'   | bash -c '...'                                                       -> 0
#
# **ET CE N'EST PAS UNE PARTICULARITE DE `dash`**, contrairement a ce que le
# rapport d'audit supposait : `bash` rend le meme 0. C'est le comportement POSIX
# de `read`, et `/bin/sh` est ici `dash` (`mesure` le meme jour, `ls -l /bin/sh`).
#
# Non exploitable AUJOURD'HUI — les cinq formes de poussee relevees au mouchard
# `od -c` posent toutes le `\n` — mais un hook dont la panne totale tient a un
# caractere que personne ne controle n'est pas garde, il est chanceux. Le sens de
# l'erreur est ici le pire possible : muet, et `rc=0`.
#
# Garde par `test_une_entree_sans_retour_a_la_ligne_final_est_lue_quand_meme`.
while read -r ref_locale sha_local ref_distante sha_distant \
        || [ -n "$ref_locale$sha_local$ref_distante$sha_distant" ]; do
    # Une ref locale nulle est une SUPPRESSION de ref : aucun commit ne part.
    if est_nul "$sha_local"; then
        continue
    fi

    if est_nul "$sha_distant"; then
        # Ref neuve : ce qui part est ce que le distant N'A PAS REELLEMENT. Voir
        # la borne ecrite en tete — `ls-remote`, jamais `refs/remotes/`.
        if exclusions=$(exclusions_pour_une_ref_neuve); then
            if [ -n "$exclusions" ]; then
                # `$exclusions` n'est deliberement PAS protege : ce sont des shas
                # separes par des espaces, et c'est le decoupage qu'on veut.
                # shellcheck disable=SC2086
                plage=$(git rev-list "$sha_local" --not $exclusions)
            else
                # Le distant ne porte AUCUNE ref qu'on possede : tout part, donc
                # tout est verifie. C'est exactement la scene du sinistre.
                plage=$(git rev-list "$sha_local")
            fi
        else
            echo "pre-push : etat du distant « $distant » indisponible —" >&2
            echo "  toute la plage qui part est verifiee (repli fail-closed)." >&2
            plage=$(git rev-list "$sha_local")
        fi
    else
        plage=$(git rev-list "$sha_distant..$sha_local")
    fi

    for commit in $plage; do
        auteur=$(git show -s --format='%ae' "$commit")
        committer=$(git show -s --format='%ce' "$commit")

        for adresse in "$auteur" "$committer"; do
            autorisee=0
            for permise in $ADRESSES_AUTORISEES; do
                [ "$adresse" = "$permise" ] && autorisee=1
            done
            if [ "$autorisee" -eq 0 ]; then
                echo "  ref $ref_locale -> $ref_distante" >&2
                refuse "l'adresse « $adresse » n'est pas autorisee." "$commit"
            fi
        done

        # L'attribution, sur le message COMPLET — sujet et corps, trailers
        # compris.
        if git show -s --format='%B' "$commit" | grep -qiE -e "$FORMES_D_ATTRIBUTION"; then
            refuse "le message porte une attribution a un assistant de generation de code." "$commit"
        fi

        # Le nom, sur les deux seuls marqueurs de robot. Voir la borne ecrite
        # en tete : l'axe qui decide reste l'adresse.
        if git show -s --format='%an%n%cn' "$commit" | grep -qE -e '\[bot\]|🤖'; then
            refuse "le nom d'auteur ou de committer est celui d'un robot." "$commit"
        fi

        # Les LIGNES AJOUTEES seulement. `--unified=0` retire le contexte, sans
        # quoi une ligne inchangee voisine d'une modification serait relue a
        # chaque commit — et un secret deja dans l'historique bloquerait toute
        # poussee future, ce qui ferait desarmer le hook.
        if git show --format= --unified=0 "$commit" \
            | grep '^+' | grep -vE '^\+\+\+' \
            | grep -qE -e "$FORMES_DE_SECRET"; then
            refuse "une ligne ajoutee porte un secret." "$commit"
        fi
    done
done
