# ============================================================
# rag-agent-chat — Configuration
# Copier en .env et remplir les valeurs manquantes
# ============================================================

# --- Stores (réseau rag_network du projet rag-ingestion-pipeline) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_documents

NEBULA_HOST=graphd
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=rag_space
# Délai d'expiration d'une requête nGQL (ms) : sans lui une requête lente
# du graphd fige la requête FastAPI qui l'attend.
NEBULA_TIMEOUT_MS=15000

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=             # même valeur que rag-ingestion-pipeline
MINIO_BUCKET=documents
MINIO_SECURE=false
# Le proxy /media ne sert que les objets référencés par le graphe. Sans cette
# borne, il sert n'importe quel objet du bucket à qui devine son chemin.
RESTRICT_MEDIA_TO_GRAPH=true

# --- LLM local (Ollama) ---
# Ollama central, servi par le projet llm-service (réseau llm-net).
OLLAMA_HOST=http://ollama-central:11434
OLLAMA_MODEL=gemma4:e4b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# Fenêtre de contexte demandée à Ollama. À passer explicitement : sinon elle
# dépend du serveur (8192 pour l'Ollama embarqué, 32768 pour le service
# central), et le même prompt donne deux comportements. Le budget de sources
# vaut LLM_NUM_CTX - LLM_MAX_TOKENS : les sources en trop sont écartées avec
# un log, au lieu d'être tronquées en silence par Ollama.
LLM_NUM_CTX=8192
LLM_THINKING=false    # Gemma 4 raisonne par défaut : prohibitif en CPU, activer si GPU

# --- Retrieval ---
# DOIT correspondre au modèle d'ingestion, sinon la recherche renvoie des
# passages au hasard sans qu'aucune erreur n'apparaisse.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# Doit parler les mêmes langues que l'embedder, sinon il défait son travail.
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Recherche hybride : BM25 en plus du dense, fusionnés par Reciprocal Rank
# Fusion. Le dense rate ce qui ne se paraphrase pas — acronymes, noms propres,
# références, chiffres — que BM25 retrouve à la lettre.
HYBRID_SEARCH=true
FETCH_K=50          # candidats par moteur avant fusion
RRF_K=60            # amortissement RRF (valeur de l'article d'origine)

# Candidats conservés après fusion, soumis au reranking. Mesuré APRÈS
# reranking sur 130 questions : 20 -> rappel 0.900, 50 -> 0.962. La
# recherche translingue dilue la fusion ; élargir le vivier laisse le
# cross-encoder trier au lieu de couper trop tôt.
RETRIEVAL_TOP_K=50
RERANK_TOP_K=10
MAX_SEARCH_ITERATIONS=3
# Traduit la question dans l'autre langue du corpus et cherche avec les deux.
# TRANSLATION_WEIGHT pondère les résultats de la traduction dans la fusion :
# à 0 elle est ignorée, à 1 elle pèse autant que la question d'origine. Mesuré
# sur 130 questions, 0.25 gagne 11 points de rappel translinguistique pour 5
# perdus en même langue (cf. scripts/sweep_retrieval.py).
CROSS_LINGUAL_SEARCH=true
TRANSLATION_WEIGHT=1.0
# Reformule une question de suivi en question autonome avant l'encodage :
# « Et pour les femmes ? » embarqué tel quel ne retrouve rien.
QUERY_REWRITE=true
# Déclare search_vectors comme outil natif Ollama. Le repli par regex sur la
# prose du modèle reste actif pour les modèles sans tool-calling.
NATIVE_TOOL_CALLING=true
AUTO_SELECT_TOP_K=3

# --- Reconstruction du contexte via le graphe ---
# Éléments conservés autour de l'élément trouvé, dans sa section. Sans borne,
# un document sans SectionHeader rattache tous ses éléments au nœud Document :
# la « section » reconstruite est alors le document entier.
CONTEXT_WINDOW_BEFORE=6
CONTEXT_WINDOW_AFTER=6
# Éléments repris de la fin de la section précédente et du début de la
# suivante. 0 désactive la traversée vers les sections voisines.
ADJACENT_SECTION_ELEMENTS=3
# Illustrations affichées au maximum. Elles proviennent des sections d'où
# viennent les citations : le modèle n'émet presque jamais [img:ID], une
# illustration n'ayant pas de texte pour qu'il en juge la pertinence.
MAX_IMAGES=4
# Le graphe ne porte qu'un aperçu du texte (tronqué à l'ingestion) ; le texte
# complet est relu dans l'index vectoriel. GRAPH_TEXT_TRUNCATION doit suivre
# GRAPH_TEXT_MAX_CHARS côté ingestion.
FULL_TEXT_FROM_VECTORS=true
GRAPH_TEXT_TRUNCATION=2000

# --- Prompts ---
PROMPTS_DIR=/app/prompts

# --- API ---
# Sessions LangGraph en attente de sélection (checkpointer en mémoire) :
# bornes de purge, sans quoi chaque question laisse son état jusqu'au redémarrage.
# Fichier SQLite des sessions LangGraph. Vide = en mémoire (sessions perdues
# au redémarrage, incompatible avec plusieurs workers uvicorn).
CHECKPOINT_DB_PATH=/app/data/checkpoints.sqlite
MAX_LIVE_SESSIONS=200
SESSION_TTL_SECONDS=3600

# Origines autorisées par CORS, séparées par des virgules. « * » ouvrirait
# l'API à n'importe quelle page web ouverte dans le navigateur de l'utilisateur.
CORS_ORIGINS=http://localhost:8506,http://localhost:8501
# Clé exigée dans l'en-tête X-API-Key. Vide = aucune authentification, ce qui
# convient en local derrière un pare-feu, pas à une exposition.
API_KEY=

LOG_LEVEL=INFO
