# ============================================================
# rag-agent-chat — Configuration
# Copier en .env et remplir les valeurs manquantes
# ============================================================

# --- Stores (réseau rag_network du projet rag-ingestion-pipeline) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_documents

NEBULA_HOST=graphd
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=rag_space
# Délai d'expiration d'une requête nGQL (ms) : sans lui une requête lente
# du graphd fige la requête FastAPI qui l'attend.
NEBULA_TIMEOUT_MS=15000

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=             # même valeur que rag-ingestion-pipeline
MINIO_BUCKET=documents
MINIO_SECURE=false
# Le proxy /media ne sert que les objets référencés par le graphe. Sans cette
# borne, il sert n'importe quel objet du bucket à qui devine son chemin.
RESTRICT_MEDIA_TO_GRAPH=true

# --- LLM local (Ollama) ---
# Ollama central, servi par le projet llm-service (réseau llm-net).
OLLAMA_HOST=http://ollama-central:11434
OLLAMA_MODEL=gemma4:e4b
LLM_TEMPERATURE=0.1
# Plafond de génération (num_predict). Il réserve la MOITIÉ de la fenêtre à la
# génération, et rien ne dit qu'elle en a besoin : les campagnes donnent 3,2
# citations par réponse, mais la LONGUEUR des réponses n'est mesurée nulle part.
# La valeur reste donc à poser sur le p95 des réponses réelles — le protocole est
# dans documentation/llm.md. Un chiffre posé au jugé serait pire que celui-ci,
# qui est au moins connu.
LLM_MAX_TOKENS=4096
# Fenêtre de contexte demandée à Ollama. À passer explicitement : sinon elle
# dépend du serveur (8192 pour l'Ollama embarqué, 32768 pour le service
# central), et le même prompt donne deux comportements. Doit rester <= à
# l'OLLAMA_CONTEXT_LENGTH du service central.
#
# Le budget de sources en dérive, mais ne vaut PAS LLM_NUM_CTX - LLM_MAX_TOKENS :
# il faut en retirer ce que le prompt contient déjà — prompt système, gabarit
# rendu, historique de conversation. Ce dernier n'était pas compté, et le prompt
# dépassait num_ctx dès le troisième tour ; Ollama tronque alors par le DÉBUT,
# donc jette le message système et ses règles de citation. Formule complète et
# chiffres dans documentation/llm.md.
LLM_NUM_CTX=8192
LLM_THINKING=false    # Gemma 4 raisonne par défaut : prohibitif en CPU, activer si GPU
# Part de la fenêtre de prompt laissée à l'historique de conversation, le reste
# allant aux sources. FORFAIT, pas une mesure : arbitrer entre les deux demande
# une mesure de la qualité multi-tour, qui n'existe pas encore. Sans plafond, une
# conversation longue affame les sources ; à 1.0 l'historique seul peut dépasser
# num_ctx, et c'est Ollama qui coupe — par le DÉBUT, donc en jetant le message
# système et ses règles de citation.
HISTORY_WINDOW_SHARE=0.25
# Part de sa source qu'un fragment tronqué doit atteindre pour valoir la place
# qu'il prend ; en dessous, la source est écartée entière. FORFAIT au sens plein :
# aucune mesure ne désigne cette valeur-ci, le prix du réglage est continu. Ce
# que la mesure établit : sans plancher, un fragment tombe à 1 % de sa source —
# le modèle en voit assez pour la citer et pas assez pour savoir ce qu'elle dit.
# Ne s'applique pas quand aucune autre source n'est retenue — mieux vaut une
# source amputée que zéro source.
TRUNCATION_FLOOR_SHARE=0.3333

# --- Retrieval ---
# DOIT correspondre au modèle d'ingestion, sinon la recherche renvoie des
# passages au hasard sans qu'aucune erreur n'apparaisse.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# Doit parler les mêmes langues que l'embedder, sinon il défait son travail.
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Recherche hybride : BM25 en plus du dense, fusionnés par Reciprocal Rank
# Fusion. Le dense rate ce qui ne se paraphrase pas — acronymes, noms propres,
# références, chiffres — que BM25 retrouve à la lettre.
HYBRID_SEARCH=true
FETCH_K=50          # candidats par moteur avant fusion
RRF_K=60            # amortissement RRF (valeur de l'article d'origine)

# Candidats conservés après fusion, soumis au reranking. Mesuré APRÈS
# reranking sur 130 questions : 20 -> rappel 0.900, 50 -> 0.962. La
# recherche translingue dilue la fusion ; élargir le vivier laisse le
# cross-encoder trier au lieu de couper trop tôt.
RETRIEVAL_TOP_K=50
RERANK_TOP_K=10
MAX_SEARCH_ITERATIONS=3
# Traduit la question dans l'autre langue du corpus et cherche avec les deux.
# TRANSLATION_WEIGHT pondère les résultats de la traduction dans la fusion :
# à 0 elle est ignorée, à 1 elle pèse autant que la question d'origine. Mesuré
# sur 130 questions, 0.25 gagne 11 points de rappel translinguistique pour 5
# perdus en même langue (cf. scripts/sweep_retrieval.py).
CROSS_LINGUAL_SEARCH=true
TRANSLATION_WEIGHT=1.0
# Reformule une question de suivi en question autonome avant l'encodage :
# « Et pour les femmes ? » embarqué tel quel ne retrouve rien.
QUERY_REWRITE=true
# Déclare search_vectors comme outil natif Ollama. Le repli par regex sur la
# prose du modèle reste actif pour les modèles sans tool-calling.
NATIVE_TOOL_CALLING=true
AUTO_SELECT_TOP_K=3

# --- Reconstruction du contexte via le graphe ---
# Éléments conservés autour de l'élément trouvé, dans sa section. Sans borne,
# un document sans SectionHeader rattache tous ses éléments au nœud Document :
# la « section » reconstruite est alors le document entier.
CONTEXT_WINDOW_BEFORE=6
CONTEXT_WINDOW_AFTER=6
# Éléments repris de la fin de la section précédente et du début de la
# suivante. 0 désactive la traversée vers les sections voisines.
ADJACENT_SECTION_ELEMENTS=3
# Illustrations affichées au maximum. Elles proviennent des sections d'où
# viennent les citations : le modèle n'émet presque jamais [img:ID], une
# illustration n'ayant pas de texte pour qu'il en juge la pertinence.
MAX_IMAGES=4
# Le graphe ne porte qu'un aperçu du texte (tronqué à l'ingestion) ; le texte
# complet est relu dans l'index vectoriel. GRAPH_TEXT_TRUNCATION doit suivre
# GRAPH_TEXT_MAX_CHARS côté ingestion.
FULL_TEXT_FROM_VECTORS=true
GRAPH_TEXT_TRUNCATION=2000

# --- Prompts ---
PROMPTS_DIR=/app/prompts

# --- API ---
# Fichier SQLite des sessions LangGraph en attente de sélection. Vide = en
# mémoire (sessions perdues au redémarrage, incompatible avec plusieurs workers
# uvicorn). Ce fichier porte AUSSI le registre de la purge, dans une table
# `sessions_agent` : le registre doit survivre au redémarrage pour atteindre une
# session qu'aucun processus vivant n'a vue, et vivre au même endroit que ce
# qu'il décrit pour ne pas en dériver.
CHECKPOINT_DB_PATH=/app/data/checkpoints.sqlite
# Bornes de la purge, en nombre et en âge. Sans elles, chaque question laisse son
# état — chunks, embeddings, contextes reconstruits — sur le disque
# indéfiniment. Aucune purge n'a lieu au DÉMARRAGE, et c'est délibéré : le
# checkpointer est sur disque précisément pour qu'une session en attente de
# sélection survive au redémarrage de l'API.
# Contrepartie à connaître : le contenu d'une session reste en clair sur le
# disque pendant tout le TTL. Cf. documentation/SECURITY.md.
MAX_LIVE_SESSIONS=200
SESSION_TTL_SECONDS=3600

# --- Capture d'usage ---
# Enregistre les questions posées, les sources proposées, celles que
# l'utilisateur décoche, les réponses et les appréciations. C'est la seule
# vérité terrain non biaisée disponible : le jeu doré est généré et jamais relu.
# VRAI par défaut, et c'est une décision — un drapeau à faux annule le
# dispositif, puisque personne ne le basculera avant les premiers utilisateurs.
# L'exposition n'est pas nouvelle : le checkpointer persiste déjà l'état complet
# du graphe dans le même volume. Cf. documentation/SECURITY.md.
# Aucune purge, aucune détection de données personnelles, aucune sortie réseau.
USAGE_CAPTURE=true
# Même volume que le checkpointer. Vide désactive la capture.
USAGE_DB_PATH=/app/data/usage.sqlite

# Origines autorisées par CORS, séparées par des virgules. « * » ouvrirait
# l'API à n'importe quelle page web ouverte dans le navigateur de l'utilisateur.
CORS_ORIGINS=http://localhost:8506,http://localhost:8501
# Clé exigée dans l'en-tête X-API-Key. Vide = aucune authentification, ce qui
# convient en local derrière un pare-feu, pas à une exposition.
API_KEY=

# INFO par défaut : un `logger.debug` est donc INVISIBLE en exploitation. C'est
# par là qu'une purge de sessions en panne est restée cachée pendant toute la vie
# du projet. Toute absorption qui compte se journalise au moins en WARNING.
LOG_LEVEL=INFO
