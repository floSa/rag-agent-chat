FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# L'INDEX DE TORCH EST UN ARGUMENT DE CONSTRUCTION, ET C'EST LE CHEMIN DE RETOUR.
#
# CE QUI ÉTAIT ÉCRIT ICI, ET QUI ÉTAIT VRAI : « Torch CPU-only d'abord : tout
# tourne en CPU dans ce service, et la roue CUDA par défaut alourdit l'image de
# plusieurs Go pour rien. » Le motif était la TAILLE. Il n'a pas disparu — il est
# mesuré, et il est le prix de cette ligne : 2,92 Go en `+cpu`, à confronter au
# chiffre que `documentation/gpu_cuda.md` §6 relève en `+cu130`.
#
# CE QUI A CHANGÉ, LE 11 SEPTEMBRE 2026 : décision du propriétaire de MESURER si
# le GPU vaut son prix sur ce service. Le mesurer exige que l'image sache faire
# du CUDA ; ça n'implique PAS que le service l'utilise, et il ne l'utilise pas
# par défaut — `TORCH_DEVICE` vaut `cpu` (`src/agent/settings.py`), donc cette
# image calcule exactement là où elle calculait, tant que personne ne l'allume.
#
# POURQUOI `cu130` ET PAS UN AUTRE. Le poste rend CUDA **13.2** (`nvidia-smi`,
# `mesuré` le 11 septembre 2026), et le pilote d'une carte sert les runtimes
# ANTÉRIEURS au sien, jamais les postérieurs. `cu130` est le plus haut index que
# ce pilote peut servir, ET le seul, avec `cu126`, à publier la roue `2.14.0` en
# cp312 — `cu128` s'arrête à 2.11.0 et `cu129` à 2.13.0 (`mesuré` le
# 11 septembre 2026 sur l'index de PyTorch). Il garde donc l'image sur la MÊME
# version de torch qu'en CPU : ce lot change le build, pas la version.
#
# LE RETOUR EN ARRIÈRE NE DEMANDE AUCUNE ÉDITION DE CE FICHIER :
#     docker build -f Dockerfile.agent \
#         --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu .
# Mode d'emploi complet, vérifications et diagnostic : `documentation/gpu_cuda.md`.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
RUN pip install --no-cache-dir --user torch --index-url ${TORCH_INDEX_URL} \
    && pip install --no-cache-dir --user -r requirements.txt


FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copier les packages installés
COPY --from=builder /root/.local /root/.local

# Code source
COPY src/agent ./src/agent
COPY src/api ./src/api

# ─── L'IDENTITÉ DU CODE QUE CETTE IMAGE CONTIENT ──────────────────────────────
#
# CE BLOC EXISTE PARCE QUE CE CHANTIER A PAYÉ DEUX FOIS SON ABSENCE. Pendant
# douze lots, l'agent en service a exécuté du code antérieur et aucun garde
# livré ne tournait ; rien ne permettait de répondre à « quel code tourne ? »
# (§4.42 du registre). Puis le lot 18 a failli rendre l'état servi anonyme et
# irrécupérable, parce qu'une étiquette datée désignait une autre image que son
# nom ne le disait.
#
# APRÈS CE BLOC, L'IMAGE PORTE SON IDENTITÉ DE DEUX FAÇONS, ET CE N'EST PAS UNE
# REDONDANCE :
#
# - en `ENV`, que `src/api/identite_du_code.py` lit et que `/health` publie —
#   c'est le chemin par lequel un exploitant, une campagne ou le pipeline
#   d'ingestion l'obtiennent SANS accès au démon Docker ;
# - en `LABEL`, que `docker image inspect` lit — et c'est le seul des deux que
#   l'exécution ne peut pas contredire. `env_file:` charge le `.env` au
#   démarrage et Docker laisse l'exécution l'emporter sur l'`ENV` de l'image :
#   une variable `RAG_AGENT_CODE_SHA` posée dans le `.env` ferait publier à
#   `/health` une identité que ce build n'a pas gravée. Le label, lui, est figé
#   ici. Un désaccord entre les deux nomme exactement ce cas, et la procédure de
#   `documentation/identite_du_code_servi.md` fait croiser les deux.
#
# LES `ARG` N'ONT PAS DE VALEUR PAR DÉFAUT, ET C'EST LA BORNE PRINCIPALE. Un
# défaut — `unknown`, `dev`, un sha écrit à la main — ferait passer une image
# NON INSTRUMENTÉE pour identifiée, ce qui est le défaut exact qu'on ferme :
# `None` veut dire « on ne me l'a pas dit », jamais « c'est à jour ». Sans
# `--build-arg`, ces trois variables arrivent VIDES dans l'image, et
# `identite_du_code()` déclare l'image ANONYME plutôt que d'inventer.
#
# CE BLOC EST APRÈS LES `COPY` À DESSEIN : le sha change à chaque commit, et
# placé plus haut il invaliderait le cache de l'installation des dépendances —
# plusieurs Go de roues retéléchargées pour une ligne de métadonnée.
#
# CE QUI LE POSE, ET C'EST LE SEUL GESTE À CONNAÎTRE : `make image`, qui relève
# le sha ET la propreté de l'arbre. Un `docker build` nu construit légitimement
# une image, mais elle sera anonyme et le dira.
# Garde : `tests/unit/test_identite_du_code.py`.
ARG CODE_SHA
ARG CODE_ARBRE
ARG CODE_CONSTRUITE_LE
ENV RAG_AGENT_CODE_SHA=${CODE_SHA}
ENV RAG_AGENT_CODE_ARBRE=${CODE_ARBRE}
ENV RAG_AGENT_CODE_CONSTRUITE_LE=${CODE_CONSTRUITE_LE}
LABEL org.opencontainers.image.revision=${CODE_SHA}
LABEL org.opencontainers.image.created=${CODE_CONSTRUITE_LE}
LABEL rag-agent-chat.code.arbre=${CODE_ARBRE}

ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
